#. Plugin Name of the plugin
#: message-export-for-flamingo.php
msgid "Message Export for Flamingo"
msgstr "Message Export for Flamingo"

#. Description of the plugin
#: message-export-for-flamingo.php
msgid "Export Contact Form 7 messages stored by Flamingo to an Excel file, filtered by form, date range, sender e-mail and text."
msgstr "Export správ z Contact Form 7 uložených vo Flamingu do súboru Excel, s filtrami podľa formulára, obdobia, e-mailu odosielateľa a textu."

#. Author of the plugin
#: message-export-for-flamingo.php
msgid "Juraj Hamara"
msgstr "Juraj Hamara"

#. Author URI of the plugin
#: message-export-for-flamingo.php
msgid "https://jurajhamara.sk"
msgstr "https://jurajhamara.sk"

#: includes/class-meff-xlsx-writer.php:113
#: includes/export.php:329
#: includes/export.php:727
msgid "A temporary file for the export could not be created."
msgstr "Dočasný súbor pre export sa nepodarilo vytvoriť."

#: includes/class-meff-xlsx-writer.php:190
#: includes/class-meff-xlsx-writer.php:202
msgid "The Excel file could not be created."
msgstr "Súbor Excel sa nepodarilo vytvoriť."

#: includes/class-meff-xlsx-writer.php:434
#: includes/export.php:453
msgid "The export could not be written to a temporary file. The server may be out of disk space."
msgstr "Export sa nepodarilo zapísať do dočasného súboru. Na serveri možno chýba miesto na disku."

#: includes/export.php:291
msgid "The Excel file cannot be created, because the zip extension of PHP is missing on this server. Ask your hosting provider to enable it."
msgstr "Súbor Excel sa nedá vytvoriť, lebo na tomto serveri chýba rozšírenie PHP zip. Požiadajte poskytovateľa hostingu, aby ho zapol."

